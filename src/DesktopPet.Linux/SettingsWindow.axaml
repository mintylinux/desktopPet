<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:DesktopPet.Linux"
        x:Class="DesktopPet.Linux.SettingsWindow"
        Title="Desktop Pet"
        Width="360" Height="420"
        WindowStartupLocation="CenterScreen"
        CanResize="False">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button x:Name="ExitButton" Content="Exit" />
      <Button x:Name="NewPetButton" Content="New Pet" />
      <Button x:Name="ChangePetButton" Content="Change Pet" IsDefault="True" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Top" Text="Choose a pet character/color:" Margin="0,0,0,8" />

    <ListBox x:Name="PetList" SelectionMode="Single">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="local:PetInfo">
          <TextBlock Text="{Binding DisplayName}" Padding="4" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
